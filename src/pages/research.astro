---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import CarouselNav from '../components/CarouselNav.astro';

// Fetch all research papers from content collection
const allResearch = await getCollection('research');

// Split into featured and secondary, sorted by order
const featuredResearch = allResearch
  .filter(paper => paper.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// Newest first, then by order within a year
const secondaryResearch = allResearch
  .filter(paper => !paper.data.featured)
  .sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order);
---

<BaseLayout title="Research" description="Carte-supported research publications spanning computer vision, healthcare AI, sustainability, and more.">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">
      <div class="max-w-3xl">
        <h1 class="carte-h1 mb-6">
          Applied AI research<br/>
          that translates.
        </h1>
        <p class="text-xl text-muted leading-relaxed">
          Carte supports collaborative research designed to be used, bridging AI with civil engineering, healthcare, sustainability, and beyond. We help partners navigate funding and connect with faculty who can solve their specific challenges.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Research Section (Static Grid) -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="carte-h2 mb-4">Selected papers from Carte projects.</h2>
        <p class="text-lg text-muted max-w-2xl mx-auto">Carte-supported research solving real engineering challenges, from building science to healthcare to sustainability.</p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredResearch.map((paper) => (
          <article class="carte-card card-demo">
            <div class="flex flex-wrap gap-2 mb-3">
              {paper.data.tags && paper.data.tags.map(tag => (
                <span class="carte-badge">{tag}</span>
              ))}
            </div>
            <h3>{paper.data.title}</h3>
            <p class="meta">{[paper.data.venue, paper.data.year, paper.data.partner].filter(Boolean).join(" · ")}</p>
            {paper.data.description && <p>{paper.data.description}</p>}
            {paper.data.link && <a href={paper.data.link} class="link-arrow">Read the paper →</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Research Portfolio Carousel Section -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between mb-12">
        <div>
          <h2 class="carte-h2 mb-4">More papers from Carte projects.</h2>
          <p class="text-lg text-muted max-w-2xl">Collaborative research across 8 engineering departments, with a focus on methods that get used outside the lab.</p>
        </div>
        <CarouselNav target="portfolio-carousel" label="publications" count={`${secondaryResearch.length} publications`} />
      </div>
      
      <!-- Carousel Container -->
      <div class="relative -mx-4">
        <div 
          id="portfolio-carousel"
          class="hide-scrollbar flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory scroll-px-4 px-4 pb-4 -mb-4"
        >
          {secondaryResearch.map((paper) => (
            <article class="carte-card card-demo flex-shrink-0 w-[320px] snap-start">

              <!-- Tags -->
              <div class="flex flex-wrap gap-2 mb-3">
                {paper.data.tags.map(tag => (
                  <span class="carte-badge">{tag}</span>
                ))}
              </div>

              <h3>{paper.data.title}</h3>

              <p class="meta">{[paper.data.venue, paper.data.year, paper.data.partner].filter(Boolean).join(" · ")}</p>

              {paper.data.description && <p>{paper.data.description}</p>}
            </article>
          ))}
        </div>
        
        <!-- Fade edges -->
        <div data-fade="start" class="absolute left-0 top-0 bottom-4 w-8 bg-gradient-to-r from-(--surface-page) to-transparent pointer-events-none"></div>
        <div data-fade="end" class="absolute right-0 top-0 bottom-4 w-8 bg-gradient-to-l from-(--surface-page) to-transparent pointer-events-none"></div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inverse-cta">
        <h2>Have a problem that needs research?</h2>
        <p>Tell us the challenge. We'll find the faculty who can take it on and help you find funding for the work.</p>
        <div class="row">
          <a class="inv-btn primary" href="/contact">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

