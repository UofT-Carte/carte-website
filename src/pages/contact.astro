---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
---

<BaseLayout title="Contact" description="Get in touch with Carte - send us an email or visit us at the Myhal Centre.">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">
      <div class="max-w-3xl">
        <h1 class="carte-h1 mb-6">
          Get in touch
        </h1>
        <p class="text-xl text-muted leading-relaxed">
          Interested in collaborating with Carte? Send us an email.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
        
        <!-- Left Column: Contact Info -->
        <div>
          <h2 class="carte-h2 mb-8">Contact information</h2>
          
          <div class="space-y-8">
            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 bg-info">
                <svg class="w-6 h-6 text-secondary-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-uoft-blue mb-1">Email</h3>
                <a href="mailto:carte@utoronto.ca" class="text-secondary-blue hover:text-secondary-blue-dark transition-colors text-lg">
                  carte@utoronto.ca
                </a>
              </div>
            </div>
            
            <!-- Location -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 bg-info">
                <svg class="w-6 h-6 text-secondary-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-uoft-blue mb-1">Location</h3>
                <p class="text-muted">
                  Myhal Centre for Engineering Innovation & Entrepreneurship<br/>
                  55 St George Street<br/>
                  Toronto, ON M5S 0C9
                </p>
              </div>
            </div>
            
            <!-- Social -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 bg-info">
                <svg class="w-6 h-6 text-secondary-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-uoft-blue mb-2">Follow us</h3>
                <SocialLinks class="flex items-center -ml-3" iconClass="w-6 h-6" />
              </div>
            </div>
          </div>
        </div>
        
        <!-- Right Column: Collapsible Actions -->
        <div class="space-y-4">
          <!-- Book a Meeting (temporarily disabled)
          <details class="group bg-card rounded-2xl border border-subtle overflow-hidden">
            <summary class="bg-uoft-blue px-6 py-5 cursor-pointer list-none select-none">
              <div class="flex items-center justify-between">
                <div>
                  <h2 class="text-xl font-bold text-white flex items-center gap-3">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    Book an Exploratory Meeting
                  </h2>
                  <p class="text-on-inverse-muted text-sm mt-1">Schedule a 30-minute call to discuss how Carte can help</p>
                </div>
                <svg class="w-6 h-6 text-white transition-transform duration-300 group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </div>
            </summary>
            <div class="p-0">
              <iframe
                src="https://outlook.office.com/book/Carte1@utoronto.onmicrosoft.com/?ismsaljsauthenabled"
                width="100%"
                height="520"
                scrolling="yes"
                style="border:0"
                title="Book a meeting with Carte"
              ></iframe>
            </div>
          </details>
          -->
          
          <!-- Newsletter Signup -->
          <details class="group bg-card rounded-2xl border border-subtle overflow-hidden">
            <summary class="px-6 py-5 cursor-pointer list-none select-none bg-uoft-blue">
              <div class="flex items-center justify-between">
                <div>
                  <h2 class="text-xl font-bold text-white flex items-center gap-3">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    Subscribe to newsletter
                  </h2>
                  <p class="text-on-inverse-muted text-sm mt-1">Stay updated on AI research, training, and events</p>
                </div>
                <svg class="w-6 h-6 text-white transition-transform duration-300 group-open:rotate-180 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </div>
            </summary>
            <div class="p-6">
              <p class="text-muted mb-6">
                Get occasional updates about AI research, upcoming training opportunities, and events at Carte.
              </p>
              <form id="contact-subscribe-form" class="space-y-4" data-subscribe>
                <div class="space-y-4" data-subscribe-fields>
                <!-- Email -->
                <div>
                  <label for="contact-email" class="carte-label">
                    Email<span class="carte-label__req">*</span>
                  </label>
                  <input
                    type="email"
                    name="email"
                    id="contact-email"
                    placeholder="you@example.com"
                    class="carte-input"
                    required
                  />
                </div>

                <!-- Name Row -->
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label for="contact-first-name" class="carte-label">First name</label>
                    <input
                      type="text"
                      name="first_name"
                      id="contact-first-name"
                      class="carte-input"
                    />
                  </div>
                  <div>
                    <label for="contact-last-name" class="carte-label">Last name</label>
                    <input
                      type="text"
                      name="last_name"
                      id="contact-last-name"
                      class="carte-input"
                    />
                  </div>
                </div>

                <!-- Organization -->
                <div>
                  <label for="contact-organization" class="carte-label">Organization</label>
                  <input
                    type="text"
                    name="organization"
                    id="contact-organization"
                    class="carte-input"
                  />
                  <p class="carte-help">If you're not at UofT.</p>
                </div>

                <!-- Academic Unit -->
                <div>
                  <label for="contact-academic-unit" class="carte-label">Academic unit</label>
                  <select
                    name="academic_unit"
                    id="contact-academic-unit"
                    class="carte-select"
                  >
                    <option value="">Select if you're at UofT</option>
                    <option value="Applied Science &amp; Engineering">Applied Science & Engineering</option>
                    <option value="Architecture, Landscape &amp; Design">Architecture, Landscape & Design</option>
                    <option value="Arts &amp; Science">Arts & Science</option>
                    <option value="Continuing Studies">Continuing Studies</option>
                    <option value="Dentistry">Dentistry</option>
                    <option value="Education">Education</option>
                    <option value="Information">Information</option>
                    <option value="Kinesiology &amp; Physical Education">Kinesiology & Physical Education</option>
                    <option value="Law">Law</option>
                    <option value="Management">Management</option>
                    <option value="Medicine">Medicine</option>
                    <option value="Music">Music</option>
                    <option value="Nursing">Nursing</option>
                    <option value="Pharmacy">Pharmacy</option>
                    <option value="Public Health">Public Health</option>
                    <option value="Social Work">Social Work</option>
                    <option value="University of Toronto Mississauga">University of Toronto Mississauga</option>
                    <option value="University of Toronto Scarborough">University of Toronto Scarborough</option>
                    <option value="Other">Other</option>
                  </select>
                </div>

                <!-- Affiliation Type -->
                <fieldset>
                  <legend class="carte-label">Affiliation</legend>
                  <div class="grid grid-cols-2 gap-2 text-sm">
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="Undergraduate" /> Undergraduate</label>
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="Graduate Student" /> Graduate Student</label>
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="Postdoc" /> Postdoc</label>
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="Faculty" /> Faculty</label>
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="Librarian" /> Librarian</label>
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="UofT Staff" /> UofT Staff</label>
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="Alumni" /> Alumni</label>
                    <label class="carte-check"><input type="checkbox" name="affiliation" value="External Partner" /> External Partner</label>
                  </div>
                </fieldset>
                </div>

                <p class="carte-status" role="status" data-subscribe-status></p>

                <button type="submit" class="carte-btn-primary w-full">Subscribe</button>
              </form>
            </div>
          </details>
        </div>
        
      </div>
    </div>
  </section>

<script>
  import "../scripts/subscribe";
</script>

</BaseLayout>
