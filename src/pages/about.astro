---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import alexHeadshot from '../assets/alex-headshot.jpg';
---

<BaseLayout title="About" description="Learn about Carte - the Centre for Analytics and Artificial Intelligence Engineering at the University of Toronto.">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">
      <div class="max-w-3xl">
        <h1 class="carte-h1 mb-6">
          Carte is UofT Engineering's applied AI centre.
        </h1>
        <p class="text-xl text-muted leading-relaxed">
          The Centre for Analytics and Artificial Intelligence Engineering at the University of Toronto's Faculty of Applied Science & Engineering.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-20 lg:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-xl">
        <p class="text-xl text-body leading-relaxed mb-8">
          Carte is the <strong>applied AI hub</strong> at UofT Engineering. We specialize in <strong>translation</strong>: helping organizations implement AI solutions through training, partnerships, and practical collaboration with world-class faculty.
        </p>
        <p class="text-lg text-muted leading-relaxed mb-8">
          Unlike traditional research institutes focused primarily on publishing papers, we're built to help you <strong>apply AI to real engineering challenges</strong>. Whether you want your team trained, a research project started, or engineering students on your problem, we start with the problem in front of you.
        </p>
        <p class="text-lg text-muted leading-relaxed">
          With over 100 faculty affiliates across 8 engineering departments, we can cover an interdisciplinary AI problem from more angles than any single lab. We also help partners fund the work through NSERC Alliance and Mitacs.
        </p>
      </div>
    </div>
  </section>

  <!-- What we do: one section, three rows -->
  <section class="py-20 lg:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="carte-h2 mb-8">What we do</h2>
      <div class="max-w-[36rem]">
        <div class="py-6 border-t border-subtle">
          <h3 class="carte-h4 mb-2">Partnerships</h3>
          <p class="text-muted leading-relaxed mb-3">We match your problem to faculty and students across UofT Engineering, and help fund the work through NSERC Alliance and Mitacs.</p>
          <a href="/partnerships" class="link-arrow">See partnership options →</a>
        </div>
        <div class="py-6 border-t border-subtle">
          <h3 class="carte-h4 mb-2">Training</h3>
          <p class="text-muted leading-relaxed mb-3">Training built around your team's work, from executive briefings to multi-day technical workshops.</p>
          <a href="/training" class="link-arrow">See training programs →</a>
        </div>
        <div class="py-6 border-t border-subtle">
          <h3 class="carte-h4 mb-2">Research</h3>
          <p class="text-muted leading-relaxed mb-3">Research we expect someone to use: partner-set problems that end in a paper, a dataset or a tool the partner keeps.</p>
          <a href="/research" class="link-arrow">See our research →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- By The Numbers Section -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="carte-h2 text-center mb-16">By the numbers</h2>
      
      <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
        <div class="text-center p-8 rounded-2xl bg-card border border-subtle">
          <div class="text-5xl lg:text-6xl font-extrabold text-uoft-blue mb-2">100+</div>
          <div class="text-lg text-muted">Faculty affiliates</div>
        </div>
        
        <div class="text-center p-8 rounded-2xl bg-card border border-subtle">
          <div class="text-5xl lg:text-6xl font-extrabold text-uoft-blue mb-2">700+</div>
          <div class="text-lg text-muted">Graduate students & postdocs</div>
        </div>
        
        <div class="text-center p-8 rounded-2xl bg-card border border-subtle">
          <div class="text-5xl lg:text-6xl font-extrabold text-uoft-blue mb-2">8</div>
          <div class="text-lg text-muted">Engineering departments</div>
        </div>
      </div>
      
      <div class="mt-12 text-center">
        <p class="text-subtle text-sm max-w-lg mx-auto">
          Spanning Chemical, Civil & Mineral, Electrical & Computer, Biomedical, Mechanical & Industrial, Materials Science, Aerospace, and Transdisciplinary Engineering
        </p>
      </div>
    </div>
  </section>

  <!-- Leadership Section -->
  <section class="py-20 lg:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="carte-h2 text-center mb-16">Leadership</h2>
      
      <div class="flex flex-col md:flex-row items-center md:items-start gap-8 lg:gap-12">
        <div class="flex-shrink-0">
          <div class="w-48 h-48 rounded-2xl overflow-hidden">
            <Image src={alexHeadshot} alt="Alex Olson" class="w-full h-full object-cover" />
          </div>
        </div>
        
        <div class="text-center md:text-left">
          <h3 class="carte-h3 mb-1">Alex Olson</h3>
          <p class="text-lg text-secondary-blue font-medium mb-4">Director</p>
          <p class="text-muted leading-relaxed">
            Alex Olson is the Director of Carte at the University of Toronto's Faculty of Applied Science & Engineering. Alex holds bachelor's and master's degrees in AI and works with researchers across the university to apply AI in new fields. Alex also teaches AI workshops for learners from many backgrounds.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Location Section -->
  <section class="py-20 lg:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="carte-h2 mb-8">Visit us</h2>
      
      <div class="bg-card rounded-2xl border border-subtle p-8 lg:p-12">
        <p class="text-lg font-semibold text-uoft-blue mb-2">
          Myhal Centre for Engineering Innovation and Entrepreneurship
        </p>
        <p class="text-muted mb-6">
          55 St. George Street<br/>
          Toronto, Ontario, Canada
        </p>
        <p class="text-subtle text-sm mb-8">
          Located on the University of Toronto's St. George campus, in the heart of downtown Toronto.
        </p>
        <a 
          href="https://ai.utoronto.ca" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center min-h-6 text-secondary-blue font-semibold hover:text-secondary-blue-dark transition-colors"
        >
          Learn more about AI at UofT
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 lg:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inverse-cta">
        <h2>One email is enough to start.</h2>
        <p>Tell us what you're working on and we'll suggest a next step.</p>
        <div class="row">
          <a class="inv-btn primary" href="/contact">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
