---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import CarouselNav from '../components/CarouselNav.astro';

// Fetch all training programs from content collection
const allTraining = await getCollection('training');

// Split into featured and secondary, sorted by order
const featuredTraining = allTraining
  .filter(t => t.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const secondaryTraining = allTraining
  .filter(t => !t.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// Collect testimonials from all training entries
const testimonials = allTraining
  .filter(t => t.data.testimonial)
  .map(t => ({ ...t.data.testimonial, source: t.data.title }));
---

<BaseLayout title="Training" description="Carte provides customizable AI and machine learning training for faculty, researchers, students, and industry partners.">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24">
      <div class="max-w-3xl">
        <h1 class="carte-h1 mb-6">
          Upskill your organization in AI and machine learning.
        </h1>
        <p class="text-xl text-muted leading-relaxed">
          Custom AI training designed for your team, built on skills they can use at work the next day. From half-day executive briefings to multi-day technical workshops, we start from your team's current level.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Training Section (Static Grid) -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <h2 class="carte-h2 mb-4">Training built for your organization.</h2>
        <p class="text-lg text-muted max-w-2xl">Practical AI training built for your organization's needs and technical level, delivered by people who have put these methods into production.</p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredTraining.map((program) => (
          <article class="carte-card card-demo">
            <h3>{program.data.title}</h3>
            <p class="meta">{[program.data.audience, program.data.duration].filter(Boolean).join(" · ")}</p>
            <p>{program.data.description}</p>
            {program.data.testimonial && (
              <div class="border-t border-subtle pt-3.5 mt-1">
                <blockquote class="quote">"{program.data.testimonial.quote}"</blockquote>
                <p class="cite">{program.data.testimonial.attribution}</p>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Training Portfolio Carousel Section -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between mb-12">
        <div>
          <h2 class="carte-h2 mb-4">Programs we've delivered.</h2>
          <p class="text-lg text-muted max-w-2xl">We also deliver training for university faculty, research groups, and international partnerships.</p>
        </div>
        <CarouselNav target="training-carousel" label="training programs" count={`${secondaryTraining.length} programs`} />
      </div>
      
      <!-- Carousel Container -->
      <div class="relative -mx-4">
        <div 
          id="training-carousel"
          class="hide-scrollbar flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory scroll-px-4 px-4 pb-4 -mb-4"
        >
          {secondaryTraining.map((program) => (
            <article class="carte-card flex-shrink-0 w-[320px] snap-start">
              
              
              <h3 class="text-base font-bold text-uoft-blue mb-2 leading-snug line-clamp-2">
                {program.data.title}
              </h3>
              
              <p class="text-sm text-muted mb-3">
                {[program.data.audience, program.data.duration, program.data.year].filter(Boolean).join(" · ")}
              </p>
              
              <p class="text-muted text-sm leading-relaxed mb-4 line-clamp-3">
                {program.data.description}
              </p>
            </article>
          ))}
        </div>
        
        <!-- Fade edges -->
        <div data-fade="start" class="absolute left-0 top-0 bottom-4 w-8 bg-gradient-to-r from-(--surface-page) to-transparent pointer-events-none"></div>
        <div data-fade="end" class="absolute right-0 top-0 bottom-4 w-8 bg-gradient-to-l from-(--surface-page) to-transparent pointer-events-none"></div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inverse-cta">
        <h2>Tell us who needs to learn what.</h2>
        <p>Describe the team and the goal. We'll propose a format, a length and a date.</p>
        <div class="row">
          <a class="inv-btn primary" href="/contact">Get in touch</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

