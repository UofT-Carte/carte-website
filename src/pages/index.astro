---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { heroImage, heroAlt } from '../assets/hero';

// Three front doors, one house: every audience gets a door of the same size
// inside the first viewport. The audience is a title in the door's colour;
// the copy names what each audience actually does with Carte.
const doors = [
  {
    tone: 'partners',
    audience: 'For partners',
    pitch: 'Training, funded research and student talent through one relationship with UofT Engineering.',
    label: 'Partner with us',
    href: '/partnerships',
  },
  {
    tone: 'faculty',
    audience: 'For faculty',
    pitch: 'Supervise a funded Mitacs intern, join the annual ML bootcamp, or get help with an NSERC Alliance application.',
    label: 'See faculty programs',
    href: '/faculty',
  },
  {
    tone: 'students',
    audience: 'For students',
    pitch: 'Paid applied-AI research roles, the Mitacs Project Explorer and the student CV bank.',
    label: 'Find a project',
    href: '/students',
  },
];

// Proof is named work, not aggregate numbers: Director-approved picks from
// the research collection, with no figures beside them.
const recentWorkIds = ['cascadedebate', 'anybald', 'safecasa', 'prostate-cancer-mortality', 'gemmas'];
const recentWork = await Promise.all(recentWorkIds.map(async id => {
  const paper = await getEntry('research', id);
  if (!paper) throw new Error(`Recent work: no research entry "${id}"`);
  return paper;
}));
---

<BaseLayout title="Home" scrollColorTransition={true}>
  <Hero />

  <!-- Three front doors -->
  <section class="pb-12 sm:pb-16" aria-label="Who Carte is for">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="door-row">
        {doors.map(door => (
          <div class:list={['door', `door--${door.tone}`]}>
            <span class="audience">{door.audience}</span>
            <p class="pitch">{door.pitch}</p>
            <a class="cta" href={door.href}><span class="label">{door.label}</span> →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Below lg the hero photo opens the second screen, after the doors, so the
       doors stay at the top of the first. Lazy: it is below the fold. -->
  <div class="lg:hidden max-w-7xl mx-auto px-4 sm:px-6 pb-12 sm:pb-16">
    <Image
      src={heroImage}
      alt={heroAlt}
      widths={[400, 800, 1200]}
      sizes="calc(100vw - 2rem)"
      format="webp"
      loading="lazy"
      class="w-full aspect-video object-cover rounded-2xl"
    />
  </div>

  <!-- Recent work: named, dated papers are the proof -->
  <section class="py-20 lg:py-28 bg-inverse">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="on-inverse mb-16">
        <h2 class="carte-h2 mb-8 text-on-inverse">Recent work.</h2>
        <ul class="work-list">
          {recentWork.map(paper => (
            <li>
              <span class="year">{paper.data.year}</span>
              <p class="title">{paper.data.title}</p>
              <p class="where">{[paper.data.venue, paper.data.partner].filter(Boolean).join(' · ')}</p>
            </li>
          ))}
        </ul>
        <a class="work-more" href="/research"><span class="label">See all research</span> →</a>
      </div>

      <!-- The close: the page's best line at full h2 strength, contact first -->
      <div class="inverse-cta inverse-cta--lead">
        <h2>Bring a real problem. Leave with a plan.</h2>
        <p>From a 3-day genomic ML intensive to LLM workshops for educators, we design AI training for each sector. Training satisfaction: 4.8/5.</p>
        <div class="row">
          <a class="inv-btn primary" href="/contact">Get in touch</a>
          <a class="inv-btn ghost" href="/training">Explore training</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Newsletter: one field, at the end of the page for readers who want to
       keep in touch. Its own white surface: by here the dot field has turned
       U of T Blue. Details are collected on /contact. -->
  <section class="py-16 bg-card" aria-label="Newsletter">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <form id="home-subscribe-form" class="max-w-md" data-subscribe>
        <div data-subscribe-fields>
          <label for="home-email" class="carte-label">Newsletter</label>
          <div class="flex items-stretch gap-2">
            <input type="email" name="email" id="home-email" class="carte-input h-auto" autocomplete="email" placeholder="you@example.com" required />
            <button type="submit" class="carte-btn-primary shrink-0">Subscribe</button>
          </div>
          <p class="carte-help">Occasional updates on training, funding calls and events.</p>
        </div>
        <p class="carte-status" role="status" data-subscribe-status></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import "../scripts/subscribe";
</script>
