---
import BaseLayout from '../layouts/BaseLayout.astro';
import CheckItem from '../components/CheckItem.astro';
import SectionIndex from '../components/SectionIndex.astro';

// One index drives both the sticky desktop rail and the phone link row.
const sections = [
  { id: 'mitacs-faculty', label: 'Mitacs supervision' },
  { id: 'training', label: 'Faculty training' },
  { id: 'funding', label: 'Funding applications' },
];
const fundingMailto = `mailto:carte@utoronto.ca?subject=${encodeURIComponent('Funding application')}`;
---

<BaseLayout title="Faculty" description="Opportunities for UofT Engineering faculty to engage with applied AI through Mitacs Accelerate supervision, training programs, and funding support.">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 lg:pt-24 pb-12">
      <div class="max-w-3xl">
        <h1 class="carte-h1 mb-6">
          Support for UofT Engineering faculty working with AI.
        </h1>
        <p class="text-xl text-muted leading-relaxed max-w-2xl">
          Supervise a funded Mitacs intern, join the annual ML bootcamp, or get help with a funding application.
        </p>
      </div>

      <SectionIndex sections={sections} variant="row" />
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 lg:pb-28 lg:grid lg:grid-cols-[13rem_1fr] lg:gap-16">
    <SectionIndex sections={sections} variant="rail" />

    <div class="max-w-[36rem]">
      <!-- Mitacs Accelerate -->
      <section id="mitacs-faculty" class="pb-16 scroll-mt-28">
        <h2 class="carte-h2 mb-6">Supervise a funded Mitacs intern.</h2>
        <p class="text-lg text-body leading-relaxed mb-4">
          Mitacs Accelerate pairs an industry partner, a faculty supervisor and an intern on one applied research project. You guide the research; the partner brings the problem and part of the funding; Mitacs matches it.
        </p>
        <p class="text-body leading-relaxed mb-8">
          Each four- to six-month internship carries a <strong>$15,000 CAD</strong> research award, or <strong>$20,000 CAD</strong> for a postdoc. Internships are repeatable: three four-month internships make a funded year of research, without drawing on your own grants.
        </p>

        <h3 class="carte-h4 mb-4">What Carte does</h3>
        <ul class="space-y-3 text-muted mb-8">
          <CheckItem>Finds students interested in your research area</CheckItem>
          <CheckItem>Connects you with industry partners looking for an academic collaborator</CheckItem>
          <CheckItem>Helps draft and submit the application, and stays involved from scoping to completion</CheckItem>
        </ul>

        <a class="link-arrow" href="/partnerships#mitacs-accelerate">See the funding model →</a>
      </section>

      <!-- Faculty training -->
      <section id="training" class="py-16 border-t border-subtle scroll-mt-28">
        <h2 class="carte-h2 mb-6">Spend a week learning machine learning.</h2>
        <p class="text-lg text-body leading-relaxed mb-4">
          Each year we run a five-day machine learning bootcamp for faculty with the Data Sciences Institute. It starts from foundations and works up to deep learning and reinforcement learning, with hands-on workshops throughout, and the agenda is revised every year.
        </p>
        <p class="text-body leading-relaxed mb-8">
          You learn alongside colleagues from other research areas, away from the lab and the lecture hall. Between bootcamps we run shorter workshops on large language models and domain-specific topics.
        </p>

        <figure class="mb-8">
          <blockquote class="text-lg text-strong leading-relaxed">
            “I've learned more in one week than in one year of self-directed efforts, which are generally bumped off track by the nature of running a lab/teaching.”
          </blockquote>
          <figcaption class="mt-2 text-sm text-muted">Faculty participant, 2023</figcaption>
        </figure>

        <a class="link-arrow" href="/training">See all training programs →</a>
      </section>

      <!-- Funding support -->
      <section id="funding" class="pt-16 border-t border-subtle scroll-mt-28">
        <h2 class="carte-h2 mb-6">Get help with a funding application.</h2>
        <p class="text-lg text-body leading-relaxed mb-8">
          We work with faculty on NSERC Alliance grants, which fund collaborative research between universities and partner organizations, and on Mitacs programs beyond Accelerate.
        </p>

        <h3 class="carte-h4 mb-4">What we help with</h3>
        <ul class="space-y-3 text-muted">
          <CheckItem><strong>Proposal review:</strong> feedback on your draft before you submit</CheckItem>
          <CheckItem><strong>Partner identification:</strong> industry partners interested in your research</CheckItem>
          <CheckItem><strong>Budget planning:</strong> a budget that fits the program's rules</CheckItem>
          <CheckItem><strong>Application guidance:</strong> requirements and deadlines, step by step</CheckItem>
        </ul>
      </section>
    </div>
  </div>

  <!-- Close: the faculty ask, not the generic one -->
  <section class="pb-20 lg:pb-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inverse-cta">
        <h2>Applying for NSERC Alliance or Mitacs? Send us your draft.</h2>
        <p>Or ask about the next faculty bootcamp.</p>
        <div class="row">
          <a class="inv-btn primary" href={fundingMailto}>Email carte@utoronto.ca</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
