---
import BaseLayout from '../layouts/BaseLayout.astro';
import CheckItem from '../components/CheckItem.astro';
import SectionIndex from '../components/SectionIndex.astro';

// One index drives both the sticky desktop rail and the phone link row.
const sections = [
  {
    id: 'mitacs',
    label: 'Mitacs internships',
    children: [
      { id: 'find-a-project', label: 'Find a project' },
      { id: 'pay', label: 'Pay' },
      { id: 'eligibility', label: 'Eligibility' },
      { id: 'how-many', label: 'How many internships' },
      { id: 'applying', label: 'Applying' },
    ],
  },
  { id: 'cv-bank', label: 'Student CV bank' },
  { id: 'mailing-list', label: 'Mailing list' },
];
const cvMailto = "mailto:carte@utoronto.ca?subject=Student CV Bank Submission&body=Hi, I'd like to add my CV to the Student CV Bank.%0D%0A%0D%0AMy research interests include: [Please describe]%0D%0AAvailability: [Full-time/Part-time/Summer/etc.]%0D%0A%0D%0A[Please attach your CV]";
---

<BaseLayout title="Students" description="Opportunities for UofT Engineering students to engage with applied AI through capstone projects, hackathons, training, and research collaboration.">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 lg:pt-24 pb-12">
      <div class="max-w-3xl">
        <h1 class="carte-h1 mb-6">
          Applied AI research opportunities for UofT students.
        </h1>
        <p class="text-xl text-muted leading-relaxed max-w-2xl">
          Paid applied AI research through Mitacs, a CV bank that UofT professors search when they need students, and a mailing list for new openings.
        </p>
      </div>

      <SectionIndex sections={sections} variant="row" />
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 lg:pb-28 lg:grid lg:grid-cols-[13rem_1fr] lg:gap-16">
    <SectionIndex sections={sections} variant="rail" />

    <div class="max-w-[36rem]">
      <!-- Mitacs Accelerate -->
      <section id="mitacs" class="pb-16 scroll-mt-28">
        <h2 class="carte-h2 mb-6">Get paid to work on applied AI research.</h2>
        <p class="text-lg text-body leading-relaxed mb-10">
          Mitacs Accelerate pairs an industry partner, a university supervisor and an intern on one research project. As the intern, you work on the partner's problem with your supervisor's guidance, and you are paid for it.
        </p>

        <h3 id="find-a-project" class="carte-h4 mb-4 scroll-mt-28">Find a project</h3>
        <ul class="space-y-3 text-muted mb-10">
          <CheckItem>Browse open projects in the <a href="/mitacs-project-explorer" class="text-secondary-blue hover:text-secondary-blue-dark font-semibold underline">Mitacs Project Explorer</a></CheckItem>
          <CheckItem>We match you with a UofT professor to supervise, or Carte supervises the project on the academic side</CheckItem>
          <CheckItem>We help you draft the Mitacs application and stay with you through submission and the project itself</CheckItem>
        </ul>

        <h3 id="pay" class="carte-h4 mb-4 scroll-mt-28">Pay</h3>
        <p class="text-body leading-relaxed mb-10">
          Each four- to six-month internship carries a research award, from which you receive at least <strong>$10,000 CAD</strong> as a stipend or salary. Postdoctoral fellows receive at least <strong>$15,000 CAD</strong>.
        </p>

        <h3 id="eligibility" class="carte-h4 mb-4 scroll-mt-28">Eligibility</h3>
        <ul class="space-y-3 text-muted mb-10">
          <CheckItem>You are a registered student or postdoctoral fellow, or you graduated within two years of the project's start date</CheckItem>
          <CheckItem>Postdoctoral fellows: your PhD was awarded less than five years before the project starts (exceptions are available)</CheckItem>
          <CheckItem>You are a Canadian citizen, a permanent resident, an international student with a valid student visa, or an international postdoctoral fellow with a valid work permit</CheckItem>
          <CheckItem>You are 18 or older</CheckItem>
        </ul>

        <h3 id="how-many" class="carte-h4 mb-4 scroll-mt-28">How many internships</h3>
        <ul class="space-y-3 text-muted mb-10">
          <CheckItem><strong>Students:</strong> any number, at UofT's discretion</CheckItem>
          <CheckItem><strong>Recent graduates:</strong> up to three four-month internships within two years of graduating</CheckItem>
          <CheckItem><strong>Postdocs:</strong> up to nine four-month internships, three years in total</CheckItem>
          <CheckItem>One internship at a time</CheckItem>
        </ul>

        <h3 id="applying" class="carte-h4 mb-4 scroll-mt-28">Applying</h3>
        <p class="text-body leading-relaxed mb-8">
          Mitacs peer-reviews each application, which takes about six to eight weeks. Proposals with several internships, or that need revisions, can take longer.
        </p>

        <a class="link-arrow" href="/mitacs-project-explorer">Explore available projects →</a>
      </section>

      <!-- CV bank -->
      <section id="cv-bank" class="py-16 border-t border-subtle scroll-mt-28">
        <h2 class="carte-h2 mb-6">Put your CV in front of UofT professors.</h2>
        <p class="text-lg text-body leading-relaxed mb-8">
          The Student CV Bank is a set of student CVs we share with UofT faculty across engineering and beyond. Professors look there when they need students for research projects, assistantships and other roles.
        </p>

        <h3 class="carte-h4 mb-4">How it works</h3>
        <ul class="space-y-3 text-muted mb-8">
          <CheckItem>Email us your CV with a short note on your interests and availability</CheckItem>
          <CheckItem>We add it to the CV bank</CheckItem>
          <CheckItem>Professors search the bank when they need students</CheckItem>
          <CheckItem>If your profile fits, the professor contacts you directly</CheckItem>
        </ul>

        <h3 class="carte-h4 mb-4">What to include</h3>
        <ul class="space-y-3 text-muted mb-8">
          <CheckItem>Your program and academic background</CheckItem>
          <CheckItem>Relevant courses and technical skills</CheckItem>
          <CheckItem>Research experience or projects</CheckItem>
          <CheckItem>Programming languages and tools</CheckItem>
          <CheckItem>Research interests</CheckItem>
          <CheckItem>Availability: full-time, part-time, summer</CheckItem>
        </ul>

        <p class="text-body leading-relaxed">
          Want feedback first? Email <a href="mailto:carte@utoronto.ca" class="text-secondary-blue hover:text-secondary-blue-dark font-semibold underline">carte@utoronto.ca</a> and we'll review your CV before it goes in.
        </p>
      </section>

      <!-- Mailing list -->
      <section id="mailing-list" class="pt-16 border-t border-subtle scroll-mt-28">
        <h2 class="carte-h2 mb-6">Hear about openings first.</h2>
        <p class="text-lg text-body leading-relaxed mb-8">
          Our mailing list carries opportunities from industry partners and UofT professors, chosen for engineering students interested in applied AI.
        </p>

        <h3 class="carte-h4 mb-4">What it sends</h3>
        <ul class="space-y-3 text-muted mb-8">
          <CheckItem>Mitacs projects and other paid research roles</CheckItem>
          <CheckItem>Professors looking for students</CheckItem>
          <CheckItem>Student competitions and innovation challenges</CheckItem>
          <CheckItem>AI and machine learning workshops and events</CheckItem>
          <CheckItem>Industry speaker events</CheckItem>
        </ul>

        <a class="link-arrow" href="/contact#newsletter">Join the mailing list →</a>
      </section>
    </div>
  </div>

  <!-- Close: the student asks, not the generic one -->
  <section class="pb-20 lg:pb-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="inverse-cta">
        <h2>Find a project, or send us your CV.</h2>
        <p>Open Mitacs projects are listed in the Project Explorer. Your CV reaches professors through the CV bank.</p>
        <div class="row">
          <a class="inv-btn primary" href="/mitacs-project-explorer">Explore available projects</a>
          <a class="inv-btn ghost" href={cvMailto}>Email your CV</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
