---
import { getImage } from 'astro:assets';
import { heroImage, heroAlt } from '../assets/hero';

// The photo only renders from lg (1024px) up, in a column that is half the
// viewport minus padding. Build a srcset for that slot; below lg the
// <picture> resolves to a 1×1 transparent GIF so phones never fetch the
// desktop sizes; the homepage serves them a smaller copy after the doors.
const heroWidths = [640, 960, 1280, 1600];
const heroSources = await Promise.all(
  heroWidths.map(async (width) => {
    const img = await getImage({ src: heroImage, width, format: 'webp' });
    return `${img.src} ${width}w`;
  })
);
const heroSrcset = heroSources.join(', ');
const heroFallback = await getImage({ src: heroImage, width: 1280, format: 'webp' });
const BLANK_GIF = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
---
<div class="relative bg-transparent overflow-visible">
  <div class="max-w-7xl mx-auto overflow-visible">
    <div class="relative z-10 pb-8 sm:pb-12 md:pb-14 lg:max-w-2xl lg:w-full lg:pb-8 pt-8 sm:pt-12 overflow-visible">
      <div class="mt-4 mx-auto max-w-7xl px-4 sm:mt-6 sm:px-6 md:mt-8 lg:px-8 overflow-visible">
        <div class="sm:text-center lg:text-left overflow-visible">
          <h1 class="text-5xl tracking-tight font-extrabold text-uoft-blue sm:text-6xl md:text-7xl leading-[1.1]">
            Learn and apply AI with Canada's leading engineers.
          </h1>
          <p class="mt-6 text-lg sm:mt-8 sm:text-xl sm:max-w-xl sm:mx-auto md:mt-8 md:text-xl lg:mx-0 font-normal leading-relaxed text-muted">
            Carte is the applied AI centre of UofT Engineering. We connect organizations, faculty and students to put AI into practice, from a first workshop to a multi-year research collaboration.
          </p>
          <!-- The hero asks for the outcome that matters most: a partnership
               enquiry. /contact carries the email and what to include. -->
          <div class="mt-8 sm:mt-10">
            <a class="carte-btn-primary" href="/contact">Start a partnership enquiry</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Photo column (desktop only; below lg the photo follows the front doors) -->
  <div class="hidden lg:flex lg:absolute lg:inset-y-0 lg:right-0 lg:w-1/2 p-4 lg:p-12 items-center justify-center">
    <div class="w-full h-96 lg:h-full bg-uoft-blue flex items-center justify-center overflow-hidden relative rounded-2xl">
      <picture class="contents">
        <source media="(max-width: 1023px)" srcset={BLANK_GIF} />
        <source media="(min-width: 1024px)" srcset={heroSrcset} sizes="calc(50vw - 6rem)" type="image/webp" />
        <img
          src={heroFallback.src}
          width={heroImage.width}
          height={heroImage.height}
          alt={heroAlt}
          class="w-full h-full object-cover"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </div>
  </div>
</div>
