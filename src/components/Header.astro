---
import uoftEngBlue from '../assets/uoft-eng-blue.svg';
import uoftCrest from '../assets/uoft-crest.svg';

const navItems = [
  { label: 'Training', href: '/training' },
  { label: 'Partnerships', href: '/partnerships' },
  { label: 'Students', href: '/students' },
  { label: 'Faculty', href: '/faculty' },
];

// Active route: Secondary Blue text + 2px underline (design system Header)
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href;
---

<header
  class="sticky top-0 z-50 border-b border-transparent bg-transparent transition-colors duration-300"
  id="main-header"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-24 items-center">
      <div class="flex-shrink-0 flex items-center gap-2 sm:gap-3">
        <!-- U of T Engineering mark: full signature on xl+, crest below. The
             institutional link lives in the footer so the first tab stop
             stays on this site. -->
        <picture class="flex items-center">
          <source media="(min-width: 1280px)" srcset={uoftEngBlue.src} width={uoftEngBlue.width} height={uoftEngBlue.height} />
          <img
            src={uoftCrest.src}
            alt="University of Toronto Engineering"
            width={uoftCrest.width}
            height={uoftCrest.height}
            class="h-8 xl:h-12 w-auto"
          />
        </picture>
        <div class="w-px h-6 sm:h-8 bg-cool-gray-50"></div>
        <a href="/" class="text-uoft-blue font-bold text-2xl tracking-tight hover:text-secondary-blue transition-colors">
          Carte
        </a>
      </div>
      <nav aria-label="Main" class="hidden md:ml-8 md:flex md:items-center md:space-x-6 lg:ml-10 lg:space-x-8">
        {navItems.map(item => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'inline-flex items-center py-2 text-base font-medium hover:text-secondary-blue transition-colors relative group',
              isActive(item.href) ? 'text-secondary-blue' : 'text-body',
            ]}
          >
            {item.label}
            <span class:list={[
              'absolute bottom-0 left-0 w-full h-0.5 bg-secondary-blue transform group-hover:scale-x-100 transition-transform origin-left',
              isActive(item.href) ? 'scale-x-100' : 'scale-x-0',
            ]}></span>
          </a>
        ))}
        <a
          href="/contact"
          class="inline-flex items-center px-6 py-2.5 text-base font-bold rounded-full text-white bg-uoft-blue hover:bg-secondary-blue transition-colors ml-4"
        >
          Contact
        </a>
      </nav>
      <!-- Mobile menu button -->
      <div class="-mr-2 flex items-center md:hidden">
        <button
          type="button"
          class="inline-flex items-center justify-center p-2 rounded-md text-subtle hover:text-uoft-blue hover:bg-sunken"
          id="mobile-menu-button"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <svg class="h-8 w-8" id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="h-8 w-8 hidden" id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile menu: a solid sheet under the header -->
<div
  class="md:hidden hidden fixed left-0 right-0 top-24 z-40"
  id="mobile-menu"
>
  <nav aria-label="Main" class="bg-page border-b border-subtle">
    <div class="px-4 pt-4 pb-6 space-y-1">
      {navItems.map(item => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'block px-4 py-3 rounded-lg text-lg font-medium hover:text-secondary-blue hover:bg-sunken transition-colors',
            isActive(item.href) ? 'text-secondary-blue' : 'text-body',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/contact"
        class="block mt-4 mx-4 px-6 py-3 text-center text-lg font-bold rounded-full text-white bg-uoft-blue hover:bg-secondary-blue transition-colors"
      >
        Contact
      </a>
    </div>
  </nav>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('main-header');
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIconOpen = document.getElementById('menu-icon-open');
    const menuIconClose = document.getElementById('menu-icon-close');

    // Scrolled header: solid page colour with a hairline, so it reads the
    // same over the cream canvas and over the U of T Blue bands.
    if (header) {
      const update = () => {
        const scrolled = window.scrollY > (window.innerWidth < 768 ? 1 : 10);
        header.classList.toggle('bg-transparent', !scrolled);
        header.classList.toggle('border-transparent', !scrolled);
        header.classList.toggle('bg-page', scrolled);
        header.classList.toggle('border-subtle', scrolled);
      };
      window.addEventListener('scroll', update, { passive: true });
      update();
    }

    // Mobile menu toggle
    if (mobileMenuButton && mobileMenu && menuIconOpen && menuIconClose) {
      const isOpen = () => !mobileMenu.classList.contains('hidden');
      const menuLabel = mobileMenuButton.querySelector('.sr-only') || mobileMenuButton;

      const openMenu = () => {
        mobileMenu.classList.remove('hidden');
        menuIconOpen.classList.add('hidden');
        menuIconClose.classList.remove('hidden');
        mobileMenuButton.setAttribute('aria-expanded', 'true');
        menuLabel.textContent = 'Close main menu';
        const first = mobileMenu.querySelector('a');
        if (first) first.focus();
      };

      const closeMenu = (returnFocus = false) => {
        mobileMenu.classList.add('hidden');
        menuIconOpen.classList.remove('hidden');
        menuIconClose.classList.add('hidden');
        mobileMenuButton.setAttribute('aria-expanded', 'false');
        menuLabel.textContent = 'Open main menu';
        if (returnFocus) mobileMenuButton.focus();
      };

      mobileMenuButton.addEventListener('click', () => (isOpen() ? closeMenu() : openMenu()));
      mobileMenu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => closeMenu()));
      document.addEventListener('click', (e) => {
        if (isOpen() && !mobileMenu.contains(e.target) && !mobileMenuButton.contains(e.target)) closeMenu();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen()) closeMenu(true);
      });
    }
  });
</script>
